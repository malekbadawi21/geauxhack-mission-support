// tsconfig.app.json — TypeScript settings for browser code (the React app in src/).
// Mostly Vite template defaults; non-default settings are commented below.
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // strict: turns on all of TypeScript's safety checks (e.g. null must be handled explicitly).
    // Required by CLAUDE.md; it is what forces us to deal with missing readings instead of ignoring them.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // extract.ts and the agent (src/lib/agent/) read the secret API key via process.env, so they must
  // never be part of the browser build. They are type-checked by tsconfig.node.json instead.
  "exclude": ["src/lib/extract.ts", "src/lib/agent"]
}
