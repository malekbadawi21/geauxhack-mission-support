// tsconfig.node.json — TypeScript settings for code that runs in Node, not the browser.
// Mostly Vite template defaults; non-default settings are commented below.
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    // strict: turns on all of TypeScript's safety checks. Required by CLAUDE.md.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Template only included vite.config.ts. We added scripts/ (CLI tools), tests/ (vitest runs in
  // Node) and src/lib/extract.ts (uses process.env + the Gemini SDK) because they run in Node.
  "include": ["vite.config.ts", "scripts", "tests", "src/lib/extract.ts"]
}
