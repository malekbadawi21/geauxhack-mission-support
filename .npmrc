# .npmrc — npm settings for this project (applies to every `npm install`, including on Vercel).
#
# legacy-peer-deps: npm 10 crashes with "Cannot read properties of null (reading 'edgesOut')" while
# resolving optional peer dependencies in this tree (vite -> jsdom -> canvas). This setting skips
# automatic peer-dependency installation, which avoids the crash. Peer deps we actually need
# (react, vite) are listed directly in package.json, so nothing is lost.
legacy-peer-deps=true
